{
  "schema_version": 1,
  "name": "memory-breathing",
  "profile_key": "session_hooks",
  "entrypoint": "session_lifecycle.py",
  "default_state": "~/.intent-translator/plugins/memory-breathing.db",
  "default_enabled": false,
  "operations": ["session_start", "session_end"],
  "writes": ["local SQLite session_snapshots table"],
  "network": false,
  "inspired_by": "https://github.com/HelloRuru/claude-memory-engine"
}
