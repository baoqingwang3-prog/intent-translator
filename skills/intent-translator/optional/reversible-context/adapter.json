{
  "schema_version": 1,
  "name": "reversible-context",
  "default_enabled": false,
  "commands": {
    "pack": "python context_pack.py --store <context.db> pack --input <sections.json>",
    "get": "python context_pack.py --store <context.db> get --hash <sha256-or-prefix>"
  },
  "writes": ["local SQLite context_blobs table"],
  "network": false
}
